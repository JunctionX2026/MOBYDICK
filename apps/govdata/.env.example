# Run `codex login` once for the same OS user before starting FastAPI.
GOVDATA_AI_ENABLED=true
GOVDATA_AI_PROVIDER=codex
GOVDATA_CODEX_TIMEOUT_SECONDS=120

# Keep these values in apps/govdata/.env or the process environment. Never commit them.
DATA_GO_KR_KEY=
DATA_GO_KR_KEY_ENCODED=
TAGO_STATION=https://apis.data.go.kr/1613000/BusSttnInfoInqireService
TAGO_ROUTE=https://apis.data.go.kr/1613000/BusRouteInfoInqireService
TAGO_BUS_LOCATION=https://apis.data.go.kr/1613000/BusLcInfoInqireService
TAGO_ARRIVAL=https://apis.data.go.kr/1613000/ArvlInfoInqireService
NMC_HOSPITAL=https://apis.data.go.kr/B552657/HsptlAsembySearchService
MOIS_POPULATION=https://apis.data.go.kr/1741000/admmSexdAgePpltn
HEAT_SHELTER=https://api.data.go.kr/openapi/tn_pubr_public_heat_wve_shltr_api

# Optional live API safety limits.
LIVE_API_TIMEOUT_SECONDS=30
LIVE_API_MAX_RESPONSE_BYTES=4194304
GOVDATA_LIVE_CACHE_ENABLED=true
GOVDATA_LIVE_REPLAY=false
